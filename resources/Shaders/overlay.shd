#version 460

[fragment]
out vec4 FragColor;

in vec4 Color;
in vec2 TexCoord;

uniform sampler2D texture0;
uniform float intensity = 0;
uniform vec4 overlayColor = vec4(1.0, 0.0, 0.0, 0.0);

void main()
{
    vec4 texColor = texture(texture0, TexCoord);
    vec3 finalColor = mix(texColor.rgb, overlayColor.rgb, intensity);
    
    FragColor = vec4(finalColor, texColor.a);
}

[vertex]
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec4 aColor;
layout (location = 2) in vec2 aTexCoord;
layout (location = 3) in vec2 aNormal;   // Doesn't make sense in the 2D context

out vec4 Color;
out vec2 TexCoord;

uniform mat4 projection;
uniform mat4 model;
uniform mat4 view;

void main()
{
    gl_Position =  vec4(aPos, 1.0) * model * view * projection;
    
    Color = aColor;
    TexCoord = aTexCoord;
}