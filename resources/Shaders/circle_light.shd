#version 460

[fragment]
out vec4 FragColor;

in vec4 Color;
in vec2 TexCoord;

uniform float intensity = 1.0;
uniform float falloff = 0.5;
uniform vec2 maskSize;

void main()
{
    vec2 centerDist = TexCoord - vec2(0.5);
    
    float aspectRatio = maskSize.x / maskSize.y;
    centerDist.x *= aspectRatio;
    
    float dist = length(centerDist) * 2.0;
    
    float lightShape = 1.0 - smoothstep(falloff, 1.0, dist);
    
    float alpha = lightShape * intensity * Color.a;
    
    FragColor = vec4(Color.rgb, alpha);
}

[vertex]
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec4 aColor;
layout (location = 2) in vec2 aTexCoord;

out vec4 Color;
out vec2 TexCoord;

uniform mat4 projection;
uniform mat4 model;
uniform mat4 view;

void main()
{
    gl_Position =  vec4(aPos, 1.0) * model * view * projection;
    Color = aColor;
    TexCoord = aTexCoord;
}